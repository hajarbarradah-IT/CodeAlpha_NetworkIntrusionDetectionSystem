alert tcp any any -> $HOME_NET any (msg:"Possible Nmap SYN scan detected"; flags:S; threshold: type both, track by_src, count 20, seconds 60; classtype:attempted-recon; sid:1000001; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"Possible SSH brute force attempt"; flags:S; threshold: type both, track by_src, count 5, seconds 60; classtype:attempted-recon; sid:1000002; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"Possible ICMP flood / DoS attempt"; itype:8; threshold: type both, track by_src, count 50, seconds 10; classtype:attempted-dos; sid:1000003; rev:1;)
alert udp any any -> $HOME_NET any (msg:"Possible UDP port scan detected"; threshold: type both, track by_src, count 20, seconds 60; classtype:attempted-recon; sid:1000004; rev:1;)
alert tcp any any -> $HOME_NET 21 (msg:"FTP anonymous login attempt"; content:"USER anonymous"; nocase; classtype:policy-violation; sid:1000005; rev:1;)
